# Copy this file to .env.local and fill in the values you need.
# .env.local is gitignored — nothing here is ever committed.

# Engineering Assistant (Gemini). Client-exposed key (NEXT_PUBLIC_) is used
# first; GEMINI_API_KEY is a server-side fallback. Optional — the twin runs
# fully without it, the Engineering Assistant panel just stays unconfigured.
NEXT_PUBLIC_GEMINI_API_KEY=
GEMINI_API_KEY=

# Optional: connects the Virtual Embedded Controller's "Wokwi · HiveMQ (live)"
# mode to a real ESP32 publishing telemetry over MQTT-over-WebSocket to a
# HiveMQ Cloud instance. Leave blank to use the in-browser SimulatedController
# instead (the default, and what the deployed Live Demo runs).
NEXT_PUBLIC_ENOKI_MQTT_HOST=
NEXT_PUBLIC_ENOKI_MQTT_USERNAME=
NEXT_PUBLIC_ENOKI_MQTT_PASSWORD=
